# 파수꾼 로컬 실행 설정 견본. 쓰려면 이 파일을 .env 로 복사한다 (.env 는 레포에 올라가지 않는다).
# 운영(Lambda)에서는 infra/ 의 Terraform 이 같은 이름으로 Lambda 환경변수를 넣는다.
# 여기에는 이름과 로컬용 예시만 둔다. 실제 웹훅 · 핑 주소는 절대 넣지 않는다.

# 카나리가 traceparent 를 붙여 호출할 쇼핑몰 주문 API (monimo-shop order)
SHOP_ORDER_URL=http://localhost:8091/api/orders
# 카나리 신선도를 조회할 API 서버 (monimo-backend api-server)
API_SERVER_URL=http://localhost:8080
# Healthchecks.io 핑 주소 (Dead Man's Switch). 파수꾼이 살아 있다는 신호
PING_URL=
# 파수꾼 전용 슬랙 웹훅. 관제 스택(notifier)과 다른 채널을 쓴다
SLACK_WEBHOOK=
# 주문 호출 뒤 API 서버 조회까지 기다리는 시간(초). 비워 두면 30
CANARY_WAIT_SECONDS=
